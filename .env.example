# ShikSheek environment variables
# Local scripts read .env (never commit it). Production values live in Supabase secrets:
#   npx supabase secrets set --env-file .env.production

# ── LINE Messaging API (LINE Developers Console → your channel) ──
LINE_CHANNEL_SECRET=            # Basic settings → Channel secret (used to verify webhook signatures)
LINE_CHANNEL_ACCESS_TOKEN=      # Messaging API → Channel access token (long-lived)

# ── Supabase ──
# Edge Functions receive SUPABASE_URL and SUPABASE_DB_URL automatically; set them only for local scripts.
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_DB_URL=                # postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared secret that pg_cron sends to the scheduler function (any long random string).
CRON_SECRET=

# Public base URL for mascot / rich menu images (Supabase Storage public bucket).
PUBLIC_ASSET_BASE_URL=          # https://<project-ref>.supabase.co/storage/v1/object/public/assets

# ── Optional AI layer (Phase 8). Without it, the rule-based parser and personality are used. ──
ANTHROPIC_API_KEY=
