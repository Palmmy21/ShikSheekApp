# ShikSheek environment variables
# Local scripts read .env (never commit it). Production values go to Supabase secrets:
#   npx supabase secrets set --env-file .env.production
# Full guide: docs/deployment.md

# ── LINE Messaging API (LINE Developers Console → your channel) ──
LINE_CHANNEL_SECRET=            # Basic settings → Channel secret (verifies webhook signatures)
LINE_CHANNEL_ACCESS_TOKEN=      # Messaging API → Channel access token (long-lived)

# ── Supabase ──
# Edge Functions receive SUPABASE_URL and SUPABASE_DB_URL automatically; set them here only for local scripts.
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_DB_URL=                # postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=      # LOCAL ONLY, for scripts/upload-assets.ts — never set as a function secret

# Public base URL of the assets bucket (printed by scripts/upload-assets.ts)
PUBLIC_ASSET_BASE_URL=          # https://<project-ref>.supabase.co/storage/v1/object/public/assets

# Shared secret pg_cron sends to the scheduler function (same value as Vault secret shiksheek_cron_secret)
CRON_SECRET=

# Optional: override the data export link base (defaults to <SUPABASE_URL>/functions/v1/data-export)
DATA_EXPORT_URL=

# ── Optional AI layer. Without a key the rule-based parser and personality are used. ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5        # any Claude model id, e.g. claude-haiku-5-5 for lower cost
AI_PERSONALITY=false            # true = AI writes the mascot's one-liners (slower replies)
